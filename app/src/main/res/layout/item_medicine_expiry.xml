<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="4dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <TextView
            android:id="@+id/textExpiryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry: 2025-12-30"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#B00020"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textMedicineNameExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pantoprazole"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableRow>
                <TextView android:text="Batch No:" android:textStyle="bold" />
                <TextView android:id="@+id/textBatchNoExpiry" android:paddingStart="8dp" />
            </TableRow>


            <TableRow>
                <TextView android:text="Stock:" android:textStyle="bold" />
                <TextView android:id="@+id/textQuantityExpiry" android:paddingStart="8dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="Manufacturer:" android:textStyle="bold" />
                <TextView android:id="@+id/textManufacturerExpiry" android:paddingStart="8dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="Category:" android:textStyle="bold" />
                <TextView android:id="@+id/textCategoryExpiry" android:paddingStart="8dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="Price:" android:textStyle="bold" />
                <TextView android:id="@+id/textPriceExpiry" android:paddingStart="8dp" />
            </TableRow>

        </TableLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
